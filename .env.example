# Banco - Supabase (sa-east-1). Substitua [PROJECT_REF] pelo ref do seu projeto
# (visível no painel Supabase > Project Settings > General) e [YOUR-DB-PASSWORD]
# pela senha do banco (Settings > Database). NUNCA commite o .env real.
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
TEST_DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Schema isolation (we share one DB but isolate schemas)
DB_SCHEMA=lubritec
TEST_DB_SCHEMA=lubritec_test

# JWT
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Magic link / reset TTLs
INVITE_TTL_DAYS=7
RESET_TTL_HOURS=1

# SMTP (Mailtrap em dev)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=changeme
SMTP_PASS=changeme
SMTP_FROM="LubriConnect <no-reply@lubritec.local>"

# App
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# WhatsApp / UazAPI
# Estas variáveis são usadas como SEED INICIAL quando o DB ainda não tem
# instância configurada. Após a primeira conexão pela UI (/settings?tab=whatsapp),
# o DB vira a fonte da verdade e as variáveis ficam ignoradas.
# Em produção, pode subir o serviço com elas vazias e configurar tudo pela UI.
UAZAPI_BASE_URL=https://api.uazapi.com
# Admin token da sua conta UazAPI (também aceita UAZAPI_TOKEN como alias legado)
UAZAPI_ADMIN_TOKEN=
UAZAPI_INSTANCE_ID=
UAZAPI_WEBHOOK_SECRET=
NO_RESPONSE_DAYS=7

# Campanhas (rate limit padrão de disparo, override por campanha)
DISPATCH_RATE_PER_MINUTE=20

# IA de atendimento — Gemini Flash 2.5
# Crie sua chave em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Modelo do Gemini. Opcional — default gemini-3.6-flash.
# Existe porque o Google aposenta modelos: o gemini-2.5-flash passou a devolver
# 404 para chaves novas e derrubou a IA de atendimento e a leitura de orçamento
# de uma vez. Com esta variável, a próxima troca é no painel, sem novo deploy.
# Para ver o que sua chave alcança: GET /v1beta/models?key=<sua-chave>.
GEMINI_MODEL=

# Supabase Storage — hospeda a imagem de header dos templates HSM (bucket público
# `hsm-headers`). Sem estas duas variáveis o upload de imagem no builder de
# template falha com "Supabase Storage não configurado".
# SERVICE_ROLE_KEY: painel Supabase > Project Settings > API Keys > service_role.
# É SECRETA (bypassa RLS) — só no servidor, NUNCA no frontend nem commitada.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Opcional — default 'hsm-headers'
SUPABASE_STORAGE_BUCKET=

# Chave de criptografia para credenciais de WhatsApp (instance tokens, access tokens, app secrets).
# Gere com: openssl rand -hex 32
# Mantenha em segredo. NUNCA commite o valor real. Rotacionar exige re-encriptar tudo via script.
WHATSAPP_CREDENTIALS_KEY=
